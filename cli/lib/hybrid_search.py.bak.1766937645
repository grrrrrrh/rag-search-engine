from typing import Any

from .keyword_search import InvertedIndex
from .semantic_search import ChunkedSemanticSearch


def hybrid_score(bm25_score: float, semantic_score: float, alpha: float = 0.5) -> float:
    return alpha * bm25_score + (1 - alpha) * semantic_score


def normalize(scores: list[float]) -> list[float]:
    if not scores:
        return []
    mn = min(scores)
    mx = max(scores)
    if mn == mx:
        return [1.0] * len(scores)
    denom = mx - mn
    return [(x - mn) / denom for x in scores]


class HybridSearch:
    def __init__(self, documents: list[dict[str, Any]]):
        self.documents = documents
        self.doc_by_id: dict[int, dict[str, Any]] = {}
        for d in documents:
            try:
                self.doc_by_id[int(d["id"])] = d
            except Exception:
                continue

        # Semantic (chunked) search
        self.semantic_search = ChunkedSemanticSearch()
        self.semantic_search.load_or_create_chunk_embeddings(documents)

        # Keyword (BM25) index
        self.idx = InvertedIndex()
        try:
            self.idx.load()
        except Exception:
            self.idx.build()
            self.idx.save()
            self.idx.load()

    def _bm25_search(self, query: str, limit: int):
        try:
            self.idx.load()
        except Exception:
            pass
        return self.idx.bm25_search(query, limit)

    def weighted_search(self, query: str, alpha: float, limit: int = 5) -> list[dict[str, Any]]:
        big_limit = limit * 500

        bm25_raw = self._bm25_search(query, big_limit)

        # Accept bm25 outputs shaped like:
        # - (doc_id, score)
        # - (doc_id, title, score, ...)
        # - {"id": doc_id, "score": score, ...}
        bm25_pairs: list[tuple[int, float]] = []
        for item in bm25_raw:
            doc_id = None
            score = 0.0
            if isinstance(item, dict):
                doc_id = item.get("id")
                score = item.get("score", 0.0)
            else:
                try:
                    doc_id = item[0]
                    score = item[1]  # if this is title, we'll fix below
                    # If second field is non-numeric (e.g. title), try third
                    if isinstance(score, str):
                        score = item[2]
                except Exception:
                    continue
            try:
                bm25_pairs.append((int(doc_id), float(score)))
            except Exception:
                continue

        bm25_ids = [d for d, _ in bm25_pairs]
        bm25_scores = [sc for _, sc in bm25_pairs]
        bm25_norm = normalize(bm25_scores)
        bm25_by_id = {doc_id: bm25_norm[i] for i, doc_id in enumerate(bm25_ids)}

        sem_fn = getattr(self.semantic_search, "search", None) or getattr(self.semantic_search, "search_chunks", None)
        if sem_fn is None:
            raise RuntimeError("ChunkedSemanticSearch has no search method")

        try:
            sem_raw = sem_fn(query, limit=big_limit)
        except TypeError:
            sem_raw = sem_fn(query, big_limit)

        sem_ids: list[int] = []
        sem_scores: list[float] = []
        for r in sem_raw:
            try:
                sem_ids.append(int(r["id"]))
                sem_scores.append(float(r["score"]))
            except Exception:
                continue

        sem_norm = normalize(sem_scores)
        sem_by_id = {doc_id: sem_norm[i] for i, doc_id in enumerate(sem_ids)}

        all_ids = set(bm25_by_id.keys()) | set(sem_by_id.keys())

        merged: list[dict[str, Any]] = []
        for doc_id in all_ids:
            doc = self.doc_by_id.get(doc_id)
            if not doc:
                continue

            bm25_s = bm25_by_id.get(doc_id, 0.0)
            sem_s = sem_by_id.get(doc_id, 0.0)
            hyb = hybrid_score(bm25_s, sem_s, alpha=alpha)

            desc = (doc.get("description") or "").strip()
            desc = " ".join(desc.split())
            snippet = (desc[:100].rstrip() + "...") if desc else "..."

            merged.append(
                {
                    "id": doc_id,
                    "title": doc.get("title", ""),
                    "document": snippet,
                    "bm25": bm25_s,
                    "semantic": sem_s,
                    "hybrid": hyb,
                }
            )

        merged.sort(key=lambda r: (-r["hybrid"], r["id"]))
        return merged[:limit]

    def rrf_search(self, query, k, limit=10):
        raise NotImplementedError("RRF hybrid search is not implemented yet.")
